{
  "manifest_version": 3,
  "name": "Chat2Local Browser Bridge",
  "version": "0.3.0",
  "description": "Optional local browser capabilities for Chat2Local.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "optional_permissions": ["tabGroups", "bookmarks"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Chat2Local connection settings" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}
