{
  "browser.tabs.create": {
    "description": "Create a Chrome tab with an HTTP or HTTPS URL.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "Absolute HTTP or HTTPS URL without credentials, spaces or control characters.",
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "^https?://[^\\s\\\\]+$",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "CreateTabArguments",
      "type": "object"
    }
  },
  "browser.tabs.list": {
    "description": "List Chrome tabs; optional exact ID/URL/title filters use AND. Results are bounded.",
    "input_schema": {
      "$defs": {
        "TabSelector": {
          "additionalProperties": false,
          "properties": {
            "tab_id": {
              "anyOf": [
                {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Native Chrome tab ID, not a ChatGPT browser ID; must be a JavaScript safe integer.",
              "title": "Tab Id"
            },
            "url": {
              "anyOf": [
                {
                  "maxLength": 8192,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Exact current URL, including query/fragment.",
              "title": "Url"
            },
            "title": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Exact case-sensitive tab title. Conditions are ANDed.",
              "title": "Title"
            }
          },
          "title": "TabSelector",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "tab": {
          "anyOf": [
            {
              "$ref": "#/$defs/TabSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "title": "ListTabsArguments",
      "type": "object"
    }
  },
